<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Emerald Green Background with rich gradient -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="14"
                android:startY="14"
                android:endX="94"
                android:endY="94"
                android:type="linear">
                <item android:color="#FF0D4E3F" android:offset="0.0" />
                <item android:color="#FF083D31" android:offset="0.5" />
                <item android:color="#FF04231C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Radial Spiritual Glow in center -->
    <path
        android:pathData="M14,14h80v80h-80z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="44"
                android:type="radial">
                <item android:color="#3322C55E" android:offset="0.0" />
                <item android:color="#1AC7A35C" android:offset="0.55" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Islamic Geometric Eight-Pointed Star Watermark (Square 1) -->
    <path
        android:pathData="M34,34h40v40h-40z"
        android:strokeColor="#1AC7A35C"
        android:strokeWidth="0.8"
        android:fillColor="#00000000" />

    <!-- Islamic Geometric Eight-Pointed Star Watermark (Square 2 rotated 45 deg) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">
        <path
            android:pathData="M34,34h40v40h-40z"
            android:strokeColor="#1AC7A35C"
            android:strokeWidth="0.8"
            android:fillColor="#00000000" />
    </group>

    <!-- Concentric Decorative Halo Circle -->
    <path
        android:pathData="M54,54m-33,0a33,33 0 1,0 66,0a33,33 0 1,0 -66,0"
        android:strokeColor="#14C7A35C"
        android:strokeWidth="0.6"
        android:fillColor="#00000000" />
</vector>
