  "ayahs": [
    {"surahId":1,"verseNumber":1,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","tafsir":"أبتدئ قراءتي باسم الله مستعينًا به."},
    {"surahId":1,"verseNumber":2,"text":"الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","tafsir":"الثناء على الله بصفاته التي كلها كمال."},
    {"surahId":1,"verseNumber":3,"text":"الرَّحْمَٰنِ الرَّحِيمِ","tafsir":"الذي وسعت رحمته كل شيء."},
    {"surahId":1,"verseNumber":4,"text":"مَالِكِ يَوْمِ الدِّينِ","tafsir":"المالك ليوم الجزاء والحساب."},
    {"surahId":1,"verseNumber":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","tafsir":"نخصك وحدك بالعبادة، ونستعين بك في أمورنا."},
    {"surahId":1,"verseNumber":6,"text":"اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ","tafsir":"دلَّنا ووفقنا إلى الطريق الواضح."},
    {"surahId":1,"verseNumber":7,"text":"صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ","tafsir":"طريق الذين أنعمت عليهم من النبيين والصديقين."},
    {"surahId":112,"verseNumber":1,"text":"قُلْ هُوَ اللَّهُ أَحَدٌ","tafsir":"الله سبحانه واحد لا شريك له."},
    {"surahId":112,"verseNumber":2,"text":"اللَّهُ الصَّمَدُ","tafsir":"المقصود في الحوائج على الدوام."},
    {"surahId":112,"verseNumber":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tafsir":"تنزّه عن الولد والوالد."},
    {"surahId":112,"verseNumber":4,"text":"وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ","tafsir":"ليس له مماثل ولا مكافئ."}
  ]
}
