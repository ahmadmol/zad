                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" stroke="currentColor" stroke-width="2"/>
                        <line x1="8" y1="7" x2="16" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <line x1="8" y1="11" x2="13" y2="11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
                <button class="audio-mode-btn active" data-mode="both" title="القرآن ثم الترجمة">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M11 5L6 9H2v6h4l5 4V5z" fill="currentColor"/>
                        <path d="M14.5 8.5a4 4 0 0 1 0 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                        <line x1="18" y1="8" x2="22" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <line x1="18" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <line x1="18" y1="16" x2="21" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="audio-player-progress-wrap">
                <span class="audio-time audio-time-current">0:00</span>
                <input type="range" id="audio-progress-bar" value="0" min="0" max="100" step="0.1">
                <span class="audio-time audio-time-total">0:00</span>
            </div>
                        <div class="audio-player-controls">
                <button id="audio-prev-btn" class="audio-ctrl-btn" title="السابقة">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="5,5 17,12 5,19" fill="currentColor"/>
                        <rect x="17" y="5" width="3" height="14" fill="currentColor"/>
                    </svg>
                </button>
                <button id="audio-play-pause-btn" class="audio-ctrl-btn audio-play-pause-main" title="تشغيل/إيقاف">
                    <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="5,3 19,12 5,21" fill="currentColor"/>
                    </svg>
                    <svg class="icon-pause" width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="display:none;">
                        <rect x="5" y="3" width="4" height="18" fill="currentColor"/>
                        <rect x="15" y="3" width="4" height="18" fill="currentColor"/>
                    </svg>
                </button>
                <button id="audio-next-btn" class="audio-ctrl-btn" title="التالية">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="19,5 7,12 19,19" fill="currentColor"/>
                        <rect x="4" y="5" width="3" height="14" fill="currentColor"/>
                    </svg>
                </button>
            </div>
            <button id="audio-close-btn" class="audio-ctrl-btn audio-close" title="إغلاق">
                <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="20" y1="4" x2="4" y2="20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    </div>
