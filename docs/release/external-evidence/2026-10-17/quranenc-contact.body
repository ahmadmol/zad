            <div id="audio-mode-switcher" style="display:none;">
                <button class="audio-mode-btn" data-mode="quran" title="القرآن فقط">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
