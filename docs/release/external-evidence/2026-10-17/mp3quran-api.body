             data-ui='{"explorer":"\u0645\u0633\u062a\u0643\u0634\u0641 \u0627\u0644\u0645\u062d\u062a\u0648\u064a\u0627\u062a","lead":"\u062a\u0635\u0641\u0651\u062d \u0647\u0646\u0627 \u0645\u0627 \u062a\u0631\u062c\u0639\u0647 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0640 API \u0645\u0628\u0627\u0634\u0631\u0629. \u0625\u0630\u0627 \u0638\u0647\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0641\u0627\u0644\u0640 API \u064a\u0639\u0645\u0644. \u0644\u0627 \u062d\u0627\u062c\u0629 \u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0645\u0637\u0648\u0651\u0631.","ready":"\u062c\u0627\u0647\u0632","loading":"\u062c\u0627\u0631\u064a \u0627\u0644\u062a\u062d\u0645\u064a\u0644\u2026","ok":"\u062a\u0645 \u0628\u0646\u062c\u0627\u062d","fail":"\u0641\u0634\u0644 \u0627\u0644\u0637\u0644\u0628","request":"\u0627\u0644\u0637\u0644\u0628","lang":"\u0644\u063a\u0629 \u0627\u0644\u0640 API","empty":"\u0644\u0627 \u062a\u0648\u062c\u062f \u0646\u062a\u0627\u0626\u062c \u0645\u0646 \u0627\u0644\u0640 API.","open_json":"\u0639\u0631\u0636 JSON","play":"\u062a\u0634\u063a\u064a\u0644","moshaf":"\u0645\u0635\u0627\u062d\u0641","surahs":"\u0633\u0648\u0631","docs":"\u062a\u0648\u062b\u064a\u0642 \u0627\u0644\u0645\u0637\u0648\u0631\u064a\u0646","show_docs":"\u0625\u0638\u0647\u0627\u0631 \u062a\u0648\u062b\u064a\u0642 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a","hide_docs":"\u0625\u062e\u0641\u0627\u0621 \u062a\u0648\u062b\u064a\u0642 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a","old":"API old versions","filter":"\u062a\u0635\u0641\u064a\u0629 \u0628\u0627\u0644\u0627\u0633\u0645\u2026","back":"\u0631\u062c\u0648\u0639","count":":n \u0639\u0646\u0635\u0631","makki":"\u0645\u0643\u064a\u0629","madani":"\u0645\u062f\u0646\u064a\u0629","timing_hint":"\u0627\u062e\u062a\u0631 \u0642\u0631\u0627\u0621\u0629 \u062b\u0645 \u0623\u062f\u062e\u0644 \u0631\u0642\u0645 \u0627\u0644\u0633\u0648\u0631\u0629","surah_num":"\u0631\u0642\u0645 \u0627\u0644\u0633\u0648\u0631\u0629","load_timing":"\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u062a\u0648\u0642\u064a\u062a","ayah":"\u0622\u064a\u0629"}'
             data-tabs='[{"id":"languages","label":"\u0627\u0644\u0644\u063a\u0627\u062a"},{"id":"suwar","label":"\u0627\u0644\u0633\u0648\u0631"},{"id":"riwayat","label":"\u0627\u0644\u0631\u0648\u0627\u064a\u0627\u062a"},{"id":"reciters","label":"\u0627\u0644\u0642\u0631\u0627\u0621"},{"id":"recent","label":"\u0627\u0644\u0623\u062d\u062f\u062b"},{"id":"radios","label":"\u0627\u0644\u0625\u0630\u0627\u0639\u0627\u062a"},{"id":"livetv","label":"\u0627\u0644\u0628\u062b \u0627\u0644\u0645\u0628\u0627\u0634\u0631"},{"id":"tafasir","label":"\u0627\u0644\u062a\u0641\u0627\u0633\u064a\u0631"},{"id":"tadabor","label":"\u0627\u0644\u062a\u062f\u0628\u0631"},{"id":"video_types","label":"\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648"},{"id":"videos","label":"\u0627\u0644\u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a"},{"id":"timing","label":"\u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0622\u064a\u0627\u062a"}]'>
