    <div class="relative w-full md:max-w-md max-h-full bg-slate-100 dark:bg-slate-dark-100 max-w-[calc(100%-2rem)] rounded-lg shadow ">
        <!-- Modal header -->
        <div class="flex items-center bo justify-between p-4 md:p-5 border-b rounded-t  border-gray-300 dark:border-slate-dark-400">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-dark-950">
                الإبلاغ عن خطأ أو خلل
            </h3>
            <button type="button" class="close text-gray-400 dark:text-gray-dark-400  bg-transparent hover:bg-gray-200 dark:hover:bg-gray-dark-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center">
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
                </svg>
                <span class="sr-only">إغلاق</span>
            </button>
        </div>
        <!-- Modal body -->
        <form id="reportForm" class="p-4 md:p-5">
            <div class="grid gap-4 mb-4 grid-cols-2">
                <div class="col-span-2">
                    <label for="reportNote" class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-dark-950">الملاحظة</label>
                    <textarea name="note" id="reportNote" rows="2" class="block p-2.5 w-full text-sm text-gray-900  dark:text-gray-dark-950 bg-gray-50  dark:bg-gray-dark-50 rounded-lg border border-gray-300  dark:border-gray-dark-300 "></textarea>
                    <small class="short-note text-danger text-red-600 dark:text-red-dark-600 mt-3 text-xs leading-6  hidden">
                        يرجى كتابة وصف أدق للمشكلة
                    </small>
                    <small class="other-error text-danger text-red-600 dark:text-red-dark-600 mt-3 text-xs leading-6  hidden">
                        الإبلاغ عن خطأ في السورة
                    </small>
                </div>
            </div>
            <button type="submit" class="flex ms-auto text-[14px]  items-center justify-center text-white bg-primary dark:bg-primary-dark hover:bg-primary-800  dark:hover:bg-primary-dark-800  focus:ring-4  font-medium rounded-xl  pe-5 ps-5 py-1.5 focus:outline-none">
                أرسل
            </button>
        </form>
    </div>
</div>    
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.5.1/styles/default.min.css">
<script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.5.1/highlight.min.js"></script>
<style>
  .api-explorer { padding: 1rem; }
  .api-explorer-head { display:flex; flex-wrap:wrap; gap:.75rem 1rem; align-items:center; justify-content:space-between; margin-bottom:.85rem; }
  .api-explorer-head h2 { margin:0; font-size:1.05rem; font-weight:700; }
  .api-lead { margin:0 0 1rem; color:#64748b; line-height:1.7; font-size:.92rem; }
  .dark .api-lead { color:#94a3b8; }
  .api-status { display:inline-flex; align-items:center; gap:.4rem; padding:.3rem .7rem; border-radius:999px; border:1px solid #e2e8f0; font-size:.82rem; font-weight:700; }
  .dark .api-status { border-color:#334155; }
  .api-status-dot { width:.5rem; height:.5rem; border-radius:50%; background:#94a3b8; }
  .api-status[data-status="loading"] .api-status-dot { background:#eab308; }
  .api-status[data-status="ok"] .api-status-dot { background:#16a34a; }
  .api-status[data-status="fail"] .api-status-dot { background:#dc2626; }
  .api-toolbar { display:flex; flex-wrap:wrap; gap:.55rem; align-items:center; margin-bottom:.85rem; }
  .api-toolbar label { font-size:.85rem; font-weight:600; }
  .api-toolbar select, .api-toolbar input[type="search"], .api-toolbar input[type="number"] {
    border:1px solid #e2e8f0; border-radius:.7rem; padding:.45rem .7rem; background:#fff; min-width:140px;
  }
  .dark .api-toolbar select, .dark .api-toolbar input[type="search"], .dark .api-toolbar input[type="number"] {
    background:#0f172a; border-color:#334155; color:#e2e8f0;
  }
  .api-tabs { display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.85rem; }
  .api-tab { border:1px solid #e2e8f0; background:#fff; border-radius:999px; padding:.4rem .85rem; font-size:.85rem; font-weight:700; cursor:pointer; }
  .dark .api-tab { background:#0f172a; border-color:#334155; color:#e2e8f0; }
  .api-tab.is-active { background:var(--color-primary, #0d9488); border-color:transparent; color:#fff; }
  .api-request { margin:0 0 .85rem; padding:.5rem .75rem; border-radius:.7rem; background:#f0fdfa; border:1px solid #99f6e4; font-size:.8rem; word-break:break-all; }
  .dark .api-request { background:#042f2e; border-color:#115e59; }
  .api-request a { color:#0f766e; font-weight:700; text-decoration:none; }
  .dark .api-request a { color:#5eead4; }
  .api-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:.7rem; }
  .api-card {
    display:grid; gap:.25rem; text-align:start; width:100%; padding:.75rem; border-radius:.9rem;
    border:1px solid #e2e8f0; background:#fff; cursor:pointer; color:inherit;
  }
  .dark .api-card { background:#0f172a; border-color:#334155; }
  .api-card:hover { border-color:#14b8a6; box-shadow:0 8px 20px rgba(15,118,110,.08); }
  .api-card strong { font-size:.92rem; line-height:1.35; }
  .api-card em { font-style:normal; color:#64748b; font-size:.78rem; }
  .api-card-meta { display:flex; flex-wrap:wrap; gap:.3rem; font-size:.75rem; color:#64748b; }
  .api-badge { display:inline-block; padding:.15rem .45rem; border-radius:999px; background:#f0fdfa; border:1px solid #99f6e4; font-weight:700; }
  .dark .api-badge { background:#042f2e; border-color:#115e59; }
  .api-empty { color:#64748b; margin:.5rem 0 0; }
  .api-detail { display:grid; gap:.75rem; }
  .api-actions { display:flex; flex-wrap:wrap; gap:.45rem; }
  .api-link-btn {
    display:inline-block; padding:.4rem .75rem; border-radius:999px; background:#0d9488; color:#fff !important;
    text-decoration:none; font-weight:700; font-size:.85rem; border:0; cursor:pointer;
  }
  .api-link-btn.muted { background:#fff; color:#0f172a !important; border:1px solid #e2e8f0; }
  .dark .api-link-btn.muted { background:#0f172a; color:#e2e8f0 !important; border-color:#334155; }
  .api-audio, .api-video { width:100%; margin-top:.35rem; max-height:280px; }
  .api-transcript {
    max-height:260px; overflow:auto; padding:.85rem 1rem; border-radius:.8rem; border:1px solid #e2e8f0;
    line-height:1.8; white-space:pre-wrap; background:#fff;
  }
  .dark .api-transcript { background:#0f172a; border-color:#334155; }
  .api-crumb { display:flex; flex-wrap:wrap; gap:.35rem; align-items:center; margin:0 0 .75rem; font-size:.88rem; }
  .api-crumb button { border:0; background:transparent; color:#0d9488; font-weight:700; cursor:pointer; padding:0; }
  .api-dev-toggle {
    border:1px solid #e2e8f0; background:#fff; border-radius:999px; padding:.4rem .85rem; font-weight:700; cursor:pointer;
  }
  .dark .api-dev-toggle { background:#0f172a; border-color:#334155; color:#e2e8f0; }
  .api-docs-wrap { margin-top:1rem; }
  .api-docs-body { overflow-x:auto; }
  .api-docs-body .flex { min-width:960px; }
</style>
<script>
  hljs.highlightAll();
  window.addEventListener('index-updated', event => { hljs.highlightAll(); });
</script>
    
