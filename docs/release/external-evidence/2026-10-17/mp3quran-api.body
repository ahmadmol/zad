  </div>
</div>

<script>
(function () {
  var root = document.getElementById('mp3-api-explorer');
  if (!root) return;
  var base = root.getAttribute('data-base');
  var lang = root.getAttribute('data-lang') || 'ar';
  var ui = JSON.parse(root.getAttribute('data-ui') || '{}');
  var tabs = JSON.parse(root.getAttribute('data-tabs') || '[]');
  var view = document.getElementById('api-view');
  var statusEl = document.getElementById('api-status');
  var statusText = statusEl.querySelector('.api-status-text');
  var requestBox = document.getElementById('api-request');
  var requestLink = document.getElementById('api-request-link');
  var crumb = document.getElementById('api-crumb');
  var langSelect = document.getElementById('api-lang-select');
  var filterInput = document.getElementById('api-filter');
  var tabsEl = document.getElementById('api-tabs');
  var currentTab = 'reciters';
  var stack = [];
  var lastCards = [];
  var cache = {};

  function t(k, fb) { return ui[k] || fb || k; }
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function setStatus(kind, msg) {
    statusEl.setAttribute('data-status', kind);
    statusText.textContent = msg;
  }
  function setRequest(url) {
    if (!url) { requestBox.hidden = true; return; }
    requestBox.hidden = false;
    requestLink.href = url;
    requestLink.textContent = url;
  }
  function apiUrl(path, params) {
    var u = new URL(base + path);
    Object.keys(params || {}).forEach(function (k) {
      if (params[k] !== undefined && params[k] !== null && params[k] !== '') u.searchParams.set(k, params[k]);
    });
    return u.toString();
  }
  async function fetchApi(path, params) {
    var url = apiUrl(path, params);
    setRequest(url);
    setStatus('loading', t('loading'));
    try {
      var res = await fetch(url, { headers: { 'Accept': 'application/json' } });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var json = await res.json();
      setStatus('ok', t('ok'));
      return { url: url, json: json };
    } catch (e) {
      setStatus('fail', t('fail'));
      throw e;
    }
  }
  function cardHtml(opts) {
    var meta = (opts.meta || []).filter(Boolean).map(function (m) {
      return '<span class="api-badge">' + esc(m) + '</span>';
    }).join('');
    return (
      '<button type="button" class="api-card" data-action="' + esc(opts.action || '') + '" data-id="' + esc(opts.id || '') + '" data-extra="' + esc(opts.extra || '') + '">' +
        '<strong>' + esc(opts.title || '') + '</strong>' +
        (opts.subtitle ? '<em>' + esc(opts.subtitle) + '</em>' : '') +
        (meta ? '<span class="api-card-meta">' + meta + '</span>' : '') +
      '</button>'
    );
  }
  function renderCards(cards, extraHtml) {
    lastCards = cards || [];
    var q = (filterInput.value || '').trim().toLowerCase();
    var filtered = !q ? lastCards : lastCards.filter(function (c) {
      return String(c.title || '').toLowerCase().indexOf(q) !== -1 || String(c.subtitle || '').toLowerCase().indexOf(q) !== -1;
    });
    var html = extraHtml || '';
    if (!filtered.length) html += '<p class="api-empty">' + esc(t('empty')) + '</p>';
    else html += '<div class="api-grid">' + filtered.map(cardHtml).join('') + '</div>';
    view.innerHTML = html;
  }
  function renderCrumb() {
    if (!stack.length) { crumb.hidden = true; crumb.innerHTML = ''; return; }
    crumb.hidden = false;
    crumb.innerHTML = stack.map(function (s, i) {
      if (i === stack.length - 1) return '<span>' + esc(s.label) + '</span>';
      return '<button type="button" data-depth="' + i + '">' + esc(s.label) + '</button><span>/</span>';
    }).join(' ');
  }
  function pad3(n) {
    n = String(n);
    return n.length >= 3 ? n : ('000' + n).slice(-3);
  }

  function buildTabs() {
    tabsEl.innerHTML = tabs.map(function (tab) {
      return '<button type="button" class="api-tab' + (tab.id === currentTab ? ' is-active' : '') + '" data-tab="' + esc(tab.id) + '">' + esc(tab.label) + '</button>';
    }).join('');
  }

  async function loadLanguagesIntoSelect() {
    try {
      var out = await fetchApi('/languages', {});
      var list = (out.json && out.json.language) || [];
      langSelect.innerHTML = list.map(function (l) {
        var code = l.locale || 'ar';
        var selected = code === lang ? ' selected' : '';
        return '<option value="' + esc(code) + '"' + selected + '>' + esc(l.native || l.language) + ' (' + esc(code) + ')</option>';
      }).join('');
      if (!list.length) langSelect.innerHTML = '<option value="ar">العربية</option><option value="eng">English</option>';
    } catch (e) {
      langSelect.innerHTML = '<option value="ar">العربية</option><option value="eng">English</option>';
    }
  }

  async function activate(tab) {
    currentTab = tab;
    stack = [];
    renderCrumb();
    filterInput.value = '';
    buildTabs();
    view.innerHTML = '<p class="api-empty">' + esc(t('loading')) + '</p>';
    try {
      if (tab === 'languages') await showLanguages();
      else if (tab === 'suwar') await showSuwar();
      else if (tab === 'riwayat') await showRiwayat();
      else if (tab === 'reciters') await showReciters();
      else if (tab === 'recent') await showRecent();
      else if (tab === 'radios') await showRadios();
      else if (tab === 'livetv') await showLiveTv();
      else if (tab === 'tafasir') await showTafasir();
      else if (tab === 'tadabor') await showTadabor();
      else if (tab === 'video_types') await showVideoTypes();
      else if (tab === 'videos') await showVideos();
      else if (tab === 'timing') await showTimingReads();
    } catch (e) {
      view.innerHTML = '<p class="api-empty">' + esc(t('fail')) + '</p>';
    }
  }

  async function showLanguages() {
    var out = await fetchApi('/languages', {});
    var list = (out.json && out.json.language) || [];
    renderCards(list.map(function (l) {
      return { action: 'noop', id: l.id, title: l.native || l.language, subtitle: l.language + ' · ' + (l.locale || ''), meta: [l.locale] };
    }), '<p class="api-empty">' + esc(String(t('count')).replace(':n', list.length)) + ' · <a class="api-link-btn muted" href="' + esc(out.url) + '" target="_blank" rel="noopener">' + esc(t('open_json')) + '</a></p>');
  }

  async function showSuwar() {
    var out = await fetchApi('/suwar', { language: lang });
    var list = (out.json && out.json.suwar) || [];
    renderCards(list.map(function (s) {
      return {
        action: 'noop', id: s.id, title: s.name, subtitle: '#' + s.id,
        meta: [s.makkia == 1 ? t('makki') : t('madani'), 'p.' + s.start_page + '-' + s.end_page]
      };
    }));
  }

  async function showRiwayat() {
    var out = await fetchApi('/riwayat', { language: lang });
    var list = (out.json && out.json.riwayat) || [];
    renderCards(list.map(function (r) {
      return { action: 'riwaya-reciters', id: r.id, title: r.name, subtitle: '#' + r.id, meta: [] };
    }));
  }

  async function showReciters(extraParams) {
    var params = Object.assign({ language: lang }, extraParams || {});
    var out = await fetchApi('/reciters', params);
    var list = (out.json && out.json.reciters) || [];
    cache.reciters = list;
    renderCards(list.map(function (r) {
      return {
        action: 'reciter', id: r.id, title: r.name, subtitle: r.letter || '',
        meta: [(r.moshaf || []).length + ' ' + t('moshaf')]
      };
    }));
  }

  async function showRecent() {
    var out = await fetchApi('/recent_reads', { language: lang });
    var list = (out.json && out.json.reads) || [];
    cache.reciters = list;
    renderCards(list.map(function (r) {
      return {
        action: 'reciter', id: r.id, title: r.name,
        subtitle: r.recent_date ? String(r.recent_date).slice(0, 10) : '',
        meta: [(r.moshaf || []).length + ' ' + t('moshaf')]
      };
    }));
  }

  async function openReciter(id) {
    var out = await fetchApi('/reciters', { language: lang, reciter: id });
    var reciter = ((out.json && out.json.reciters) || [])[0];
    if (!reciter) { view.innerHTML = '<p class="api-empty">' + esc(t('empty')) + '</p>'; return; }
    stack = [{ label: tabs.find(function (x){return x.id===currentTab;}).label || '…', kind: 'list' }, { label: reciter.name, kind: 'reciter', id: id }];
    renderCrumb();
    var html = '<div class="api-detail"><div><strong style="font-size:1.05rem">' + esc(reciter.name) + '</strong>';
    html += '<div class="api-actions" style="margin-top:.55rem"><a class="api-link-btn muted" href="' + esc(out.url) + '" target="_blank" rel="noopener">' + esc(t('open_json')) + '</a></div></div>';
    html += '<h3 style="margin:0;font-size:.95rem">' + esc(t('moshaf')) + '</h3>';
    (reciter.moshaf || []).forEach(function (m) {
      html += '<div class="api-card" style="cursor:default">';
      html += '<strong>' + esc(m.name) + '</strong>';
      html += '<em dir="ltr">' + esc(m.server) + '</em>';
      html += '<span class="api-card-meta"><span class="api-badge">' + esc(m.surah_total) + ' ' + esc(t('surahs')) + '</span></span>';
      var first = String(m.surah_list || '1').split(',')[0];
      if (m.server && first) {
        var audio = m.server.replace(/\/?$/, '/') + pad3(first) + '.mp3';
        html += '<audio class="api-audio" controls preload="none" src="' + esc(audio) + '"></audio>';
      }
      html += '</div>';
    });
    html += '</div>';
    view.innerHTML = html;
  }

  async function showRadios() {
    var out = await fetchApi('/radios', { language: lang });
    var list = (out.json && out.json.radios) || [];
    renderCards(list.map(function (r) {
      return { action: 'radio', id: r.id, title: r.name, subtitle: '', extra: r.url, meta: ['#' + r.id] };
    }));
  }

  function openRadio(name, url) {
    stack = [{ label: t('radios') || 'Radios', kind: 'list' }, { label: name, kind: 'radio' }];
    renderCrumb();
    setRequest(url);
    view.innerHTML =
      '<div class="api-detail"><strong>' + esc(name) + '</strong>' +
      '<div class="api-actions"><a class="api-link-btn muted" href="' + esc(url) + '" target="_blank" rel="noopener" dir="ltr">' + esc(url) + '</a></div>' +
      '<audio class="api-audio" controls preload="none" src="' + esc(url) + '"></audio></div>';
  }

  async function showLiveTv() {
    var out = await fetchApi('/live-tv', { language: lang });
    var list = (out.json && (out.json.livetv || out.json.live_tv || out.json.tvs)) || [];
    renderCards(list.map(function (r) {
      return { action: 'radio', id: r.id, title: r.name, extra: r.url, meta: ['live'] };
    }));
  }

  async function showTafasir() {
    var out = await fetchApi('/tafasir', { language: lang });
    var list = (out.json && out.json.tafasir) || [];
    renderCards(list.map(function (r) {
      return { action: 'tafsir', id: r.id, title: r.name, subtitle: '', meta: ['#' + r.id] };
    }));
  }

  async function openTafsir(id, name) {
    var out = await fetchApi('/tafsir', { language: lang, tafsir: id });
    stack = [{ label: tabs.find(function(x){return x.id==='tafasir';}).label, kind: 'list' }, { label: name || ('#' + id), kind: 'tafsir' }];
    renderCrumb();
    var data = out.json && out.json.tafasir;
    var items = [];
    if (data && data.sora) {
      Object.keys(data.sora).forEach(function (sid) {
        (data.sora[sid] || []).forEach(function (row) {
          items.push({
            action: 'audio', id: row.id || sid, title: row.name || ('#' + sid),
            extra: row.url, meta: ['sura ' + (row.sura_id || sid)]
          });
        });
      });
    } else if (Array.isArray(data)) {
      items = data.map(function (row) {
        return { action: 'audio', id: row.id, title: row.name, extra: row.url, meta: [] };
      });
    }
    renderCards(items, '<p class="api-empty"><a class="api-link-btn muted" href="' + esc(out.url) + '" target="_blank" rel="noopener">' + esc(t('open_json')) + '</a></p>');
  }

  async function showTadabor() {
    var out = await fetchApi('/tadabor', { language: lang });
    var bag = (out.json && out.json.tadabor) || {};
    var items = [];
    Object.keys(bag).forEach(function (sid) {
      (bag[sid] || []).forEach(function (row) {
        items.push({
          action: 'tadabor-item', id: row.id,
          title: (row.sora_name || '').replace(/\s+/g, ' ').trim() || ('#' + row.id),
          subtitle: row.reciter_name || '',
          extra: JSON.stringify({ audio: row.audio_url, image: row.image_url, text: row.text, name: row.sora_name }),
          meta: [row.rewaya_name || '']
        });
      });
    });
    renderCards(items);
  }

  function openTadaborItem(payload) {
    var d = {};
    try { d = JSON.parse(payload || '{}'); } catch (e) {}
    stack.push({ label: d.name || t('tadabor'), kind: 'item' });
    renderCrumb();
    var html = '<div class="api-detail">';
    if (d.image) html += '<img src="' + esc(d.image) + '" alt="" style="max-width:220px;border-radius:.8rem">';
    html += '<div class="api-transcript">' + esc(d.text || '') + '</div>';
    if (d.audio) html += '<audio class="api-audio" controls preload="none" src="' + esc(d.audio) + '"></audio>';
    html += '</div>';
    view.innerHTML = html;
  }

  async function showVideoTypes() {
    var out = await fetchApi('/video_types', { language: lang });
    var list = (out.json && out.json.video_types) || [];
    renderCards(list.map(function (r) {
      return { action: 'noop', id: r.id, title: r.video_type || r.name, subtitle: '#' + r.id, meta: [] };
    }));
  }

  async function showVideos() {
    var out = await fetchApi('/videos', { language: lang });
    var list = (out.json && out.json.videos) || [];
    var cards = [];
    list.forEach(function (group) {
      (group.videos || []).forEach(function (v) {
        cards.push({
          action: 'video', id: v.id,
          title: group.reciter_name || ('#' + v.id),
          subtitle: 'type ' + (v.video_type || ''),
          extra: JSON.stringify({ url: v.video_url, thumb: v.video_thumb_url, name: group.reciter_name }),
          meta: ['#' + v.id]
        });
      });
    });
    renderCards(cards);
  }

  function openVideo(payload) {
    var d = {};
    try { d = JSON.parse(payload || '{}'); } catch (e) {}
    stack.push({ label: d.name || 'video', kind: 'video' });
    renderCrumb();
    var html = '<div class="api-detail"><strong>' + esc(d.name || '') + '</strong>';
    if (d.thumb) html += '<img src="' + esc(d.thumb) + '" alt="" style="max-width:240px;border-radius:.8rem">';
    if (d.url) html += '<video class="api-video" controls preload="none" src="' + esc(d.url) + '"></video>';
    html += '</div>';
    view.innerHTML = html;
  }

  async function showTimingReads() {
    var out = await fetchApi('/ayat_timing/reads', {});
    var list = Array.isArray(out.json) ? out.json : ((out.json && out.json.reads) || []);
    cache.timingReads = list;
    var extra =
      '<div class="api-toolbar" style="margin-top:.25rem">' +
        '<label>' + esc(t('surah_num')) + '</label>' +
        '<input id="timing-surah" type="number" min="1" max="114" value="1">' +
        '<span class="api-empty">' + esc(t('timing_hint')) + '</span>' +
      '</div>';
    renderCards(list.map(function (r) {
      return {
        action: 'timing-read', id: r.id, title: r.name,
        subtitle: r.rewaya || '',
        meta: [r.soar_count ? (r.soar_count + ' ' + t('surahs')) : '']
      };
    }), extra);
  }

  async function openTiming(readId, name) {
    var surahEl = document.getElementById('timing-surah');
    var surah = surahEl ? surahEl.value : '1';
    var out = await fetchApi('/ayat_timing', { surah: surah, read: readId });
    stack = [{ label: tabs.find(function(x){return x.id==='timing';}).label, kind: 'list' }, { label: (name || readId) + ' · ' + surah, kind: 'timing' }];
    renderCrumb();
    var rows = Array.isArray(out.json) ? out.json : [];
    var html = '<div class="api-detail"><div class="api-actions"><a class="api-link-btn muted" href="' + esc(out.url) + '" target="_blank" rel="noopener">' + esc(t('open_json')) + '</a></div>';
    html += '<div class="api-grid">';
    rows.slice(0, 80).forEach(function (row) {
      html += '<div class="api-card" style="cursor:default"><strong>' + esc(t('ayah')) + ' ' + esc(row.ayah) + '</strong>' +
        '<em>' + esc(row.start_time) + ' → ' + esc(row.end_time) + '</em></div>';
    });
    html += '</div></div>';
    view.innerHTML = html;
  }

  function openAudio(title, url) {
    stack.push({ label: title || 'audio', kind: 'audio' });
    renderCrumb();
    view.innerHTML = '<div class="api-detail"><strong>' + esc(title || '') + '</strong><audio class="api-audio" controls preload="none" src="' + esc(url) + '"></audio></div>';
  }

  tabsEl.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-tab]');
    if (!btn) return;
    activate(btn.getAttribute('data-tab'));
  });

  langSelect.addEventListener('change', function () {
    lang = langSelect.value || 'ar';
    activate(currentTab);
  });

  filterInput.addEventListener('input', function () {
    renderCards(lastCards);
  });

  crumb.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-depth]');
    if (!btn) return;
    activate(currentTab);
  });

  view.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-action]');
    if (!btn) return;
    var action = btn.getAttribute('data-action');
    var id = btn.getAttribute('data-id');
    var extra = btn.getAttribute('data-extra');
    var title = (btn.querySelector('strong') || {}).textContent || '';
    var run = Promise.resolve();
    if (action === 'reciter') run = openReciter(id);
    else if (action === 'riwaya-reciters') run = showReciters({ rewaya: id });
    else if (action === 'radio') openRadio(title, extra);
    else if (action === 'tafsir') run = openTafsir(id, title);
    else if (action === 'tadabor-item') openTadaborItem(extra);
    else if (action === 'video') openVideo(extra);
    else if (action === 'audio') openAudio(title, extra);
    else if (action === 'timing-read') run = openTiming(id, title);
    run.catch(function () {
      view.innerHTML = '<p class="api-empty">' + esc(t('fail')) + '</p>';
    });
  });

  var docsToggle = document.getElementById('api-docs-toggle');
  var docsBody = document.getElementById('api-docs-body');
  if (docsToggle && docsBody) {
    docsToggle.addEventListener('click', function () {
      var open = docsBody.hasAttribute('hidden');
      if (open) {
        docsBody.removeAttribute('hidden');
        docsToggle.setAttribute('aria-expanded', 'true');
        docsToggle.textContent = t('hide_docs');
        try { hljs.highlightAll(); } catch (e) {}
      } else {
        docsBody.setAttribute('hidden', '');
        docsToggle.setAttribute('aria-expanded', 'false');
        docsToggle.textContent = t('show_docs');
      }
    });
  }

  buildTabs();
  loadLanguagesIntoSelect().finally(function () {
    activate('reciters');
  });
})();
</script>
