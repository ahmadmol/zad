<?xml version="1.0" encoding="utf-8"?>
<!--
   Explicitly restrict all backup domains for "إحسان" to protect local PII.
   This file is used for legacy Auto Backup (Android 6.0 to 11).
   Global android:allowBackup="false" is set in the manifest as the primary protection.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
